{
  "name": "anoop-sites",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @anoop/resume",
    "dev:portfolio": "npm run dev -w @anoop/portfolio",
    "dev:resume": "npm run dev -w @anoop/resume",
    "build": "npm run build --workspaces --if-present",
    "build:portfolio": "npm run build -w @anoop/portfolio",
    "build:resume": "npm run build -w @anoop/resume",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.9"
  }
}
